if(NOT TARGET abyssal_camera)
    set(ABYSSAL_USE_PICO_SDK ON)
    add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/../../../drivers/camera"
                     "${CMAKE_CURRENT_BINARY_DIR}/camera-driver")
endif()
add_executable(PicoCamera_Test "${CMAKE_CURRENT_LIST_DIR}/../../../tools/camera/main.c")
target_compile_features(PicoCamera_Test PRIVATE c_std_11)
target_include_directories(PicoCamera_Test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../../include")
target_link_libraries(PicoCamera_Test PRIVATE abyssal_camera)
pico_enable_stdio_usb(PicoCamera_Test 1)
pico_enable_stdio_uart(PicoCamera_Test 0)
pico_add_extra_outputs(PicoCamera_Test)
